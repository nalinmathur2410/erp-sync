# ==================================
# 🔧 App Settings
# ==================================
PORT=4000
NODE_ENV=development

# ==================================
# 🌐 Frontend Client (Angular)
# ==================================
CLIENT_URL=http://localhost:4200

# ==================================
# 🗄️ PostgreSQL Database
# ==================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres
DB_SSL=false          # set to true in production
DB_SYNC=true 

# ==================================
# 🔐 Authentication (only if using JWT)
# ==================================
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=7d

# ==================================
# 🔁 Offline Sync API Settings
# ==================================
SYNC_QUEUE_ENABLED=true
SYNC_RETRY_INTERVAL=3000   # ms
SYNC_MAX_RETRY=5

# ==================================
# 📊 Logging
# ==================================
LOG_LEVEL=debug     # debug | verbose | log | warn | error

# ==================================
# 🚀 Swagger Docs
# ==================================
ENABLE_SWAGGER=true
